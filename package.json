{
  "name": "codedok-native",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor native wrapper for the CodedOK web app \u2014 the iOS (and later Android) App Store build. The web app itself lives in app/ and is deployed separately via Cloudflare (wrangler); this only packages it into a native binary.",
  "scripts": {
    "add:ios": "cap add ios",
    "sync": "cap sync",
    "open:ios": "cap open ios",
    "vendor": "node scripts/vendor-capacitor.js"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/share": "^6.0.3",
    "@capacitor/push-notifications": "^6.0.4",
    "@capacitor/status-bar": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/keyboard": "^6.0.3",
    "@revenuecat/purchases-capacitor": "9.2.2",
    "@capacitor/text-zoom": "^6.0.3",
    "@capacitor-community/apple-sign-in": "^6.0.0",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/network": "^6.0.4",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@aparajita/capacitor-biometric-auth": "8.0.2",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/barcode-scanner": "1.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
